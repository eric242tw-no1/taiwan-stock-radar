{
  "productName": "台股AI雷達",
  "version": "1.0.0",
  "identifier": "com.taiwan.ai.stock.radar",
  "build": {
    "devUrl": "http://localhost:3002",
    "frontendDist": "http://localhost:3002",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "台股AI雷達",
