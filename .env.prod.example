# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DBNAME

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
SECRET_KEY=
ALLOWED_ORIGINS=https://yourdomain.com

# Next.js
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# GitHub Container Registry (for image pulls)
GITHUB_REPOSITORY=your-org/taiwan-stock-radar
IMAGE_TAG=latest

# AI services
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# FinMind / broker
FINMIND_TOKEN=
YUANTA_ACCOUNT=
YUANTA_PASSWORD=

# 元大 YuantaSparkAPI（BROKER=yuanta 時需填入）
# YUANTA_SIMULATION=false           # true=模擬模式（預設），false=連接真實 API
# YUANTA_ENV=UAT                    # UAT=測試環境，PROD=正式環境
# YUANTA_DLL_DIR=/path/to/dll       # YuantaSparkAPI.dll 所在資料夾（Windows 或 Linux）
# YUANTA_PFX_PATH=                  # Linux/Mac 憑證 .pfx 路徑（Windows 不需要）
# YUANTA_PFX_PASS=                  # Linux/Mac 憑證密碼（Windows 不需要）

# 券商選擇（yuanta | sinopac）
BROKER=sinopac

# 永豐金 Shioaji（BROKER=sinopac 時需填入）
SINOPAC_ACCOUNT=
SINOPAC_PASSWORD=

# Domain
DOMAIN=yourdomain.com

# 交易環境（simulation | production）
TRADING_ENV=simulation
NEXT_PUBLIC_TRADING_ENV=simulation
